-- 4. ESP (BOX OUTLINE - KHUNG VIỀN)
local function CreateESP(plr)
    local Line = Drawing.new("Line")
    local Box = Drawing.new("Square")
    local HPBg = Drawing.new("Square")
    local HPBar = Drawing.new("Square")
    
    RunService.RenderStepped:Connect(function()
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr ~= LocalPlayer and plr.Character.Humanoid.Health > 0 then
            local Root = plr.Character.HumanoidRootPart
            local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
            
            if OnScreen then
                local SizeY = 2200 / Pos.Z
                local SizeX = SizeY / 1.5
                
                -- LINE TOP
                Line.Visible = _G.Config.ESPLine
                Line.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
                Line.To = Vector2.new(Pos.X, Pos.Y - SizeY/2)
                Line.Color = Color3.new(1,1,1)
                Line.Thickness = 1
                
                -- BOX OUTLINE (KHUNG VIỀN, KHÔNG ĐẶC)
                Box.Visible = _G.Config.ESPBox
                Box.Size = Vector2.new(SizeX, SizeY)
                Box.Position = Vector2.new(Pos.X - SizeX/2, Pos.Y - SizeY/2)
                Box.Color = Color3.fromRGB(0, 255, 100)
                Box.Filled = false      -- <<< QUAN TRỌNG: CHỈ HIỆN KHUNG
                Box.Thickness = 1.5      -- Độ dày viền
                
                -- HP BAR
                if _G.Config.ESPHP then
                    local health = plr.Character.Humanoid.Health / plr.Character.Humanoid.MaxHealth
                    HPBg.Visible = true
                    HPBg.Size = Vector2.new(3, SizeY)
                    HPBg.Position = Vector2.new(Pos.X - SizeX/2 - 6, Pos.Y - SizeY/2)
                    HPBg.Color = Color3.new(0,0,0)
                    HPBg.Filled = true
                    
                    HPBar.Visible = true
                    HPBar.Size = Vector2.new(3, SizeY * health)
                    HPBar.Position = Vector2.new(Pos.X - SizeX/2 - 6, Pos.Y - SizeY/2 + (SizeY - (SizeY * health)))
                    HPBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), health)
                    HPBar.Filled = true
                else
                    HPBg.Visible = false
                    HPBar.Visible = false
                end
            else
                Line.Visible = false
                Box.Visible = false
                HPBg.Visible = false
                HPBar.Visible = false
            end
        else
            Line.Visible = false
            Box.Visible = false
            HPBg.Visible = false
            HPBar.Visible = false
        end
    end)
end

for _, v in pairs(Players:GetPlayers()) do CreateESP(v) end
Players.PlayerAdded:Connect(CreateESP)

