-- 7. AIMBOT GHIM ĐẦU CỰC MẠNH + HITBOX
RunService.RenderStepped:Connect(function()
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Position = Center
    
    -- Speed
    if _G.Config.SpeedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local H = LocalPlayer.Character.Humanoid
        if H.MoveDirection.Magnitude > 0 then
            LocalPlayer.Character:TranslateBy(H.MoveDirection * _G.Config.SpeedPower)
        end
    end
    
    local Target = nil
    local MinDist = _G.Config.AimRadius
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character.Humanoid.Health > 0 then
            local head = p.Character.Head
            local Pos, On = Camera:WorldToViewportPoint(head.Position)
            if On then
                local Dist = (Vector2.new(Pos.X, Pos.Y) - Center).Magnitude
                if Dist < MinDist then
                    MinDist = Dist
                    Target = head
                end
            end
            
            -- HITBOX 4.5
            if _G.Config.Hitbox then
                head.Size = Vector3.new(4.5, 4.5, 4.5)
                head.Transparency = 0.5
                head.CanCollide = false
            else
                head.Size = Vector3.new(1.2, 1.2, 1.2)
                head.Transparency = 0
                head.CanCollide = true
            end
        end
    end
    
    -- FIX AIMBOT: GHIM ĐẦU CỰC MẠNH
    if _G.Config.Aimbot and Target then
        local targetPos = Target.Position
        -- Dùng CFrame để xoay camera, Lerp với smoothness thấp để bám sát
        local newCF = CFrame.new(Camera.CFrame.Position, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(newCF, _G.Config.Smoothness)
    end
end)

